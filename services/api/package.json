{
  "name": "@smartpick/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.prisma.json",
    "db:generate": "dotenv -e ../../.env -- prisma generate --schema prisma/schema.prisma",
    "db:validate": "dotenv -e ../../.env -- prisma validate --schema prisma/schema.prisma",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "dotenv -e ../../.env -- prisma db seed --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "fastify": "5.2.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "dotenv-cli": "8.0.0",
    "prisma": "6.19.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
