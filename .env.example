# Copy this file to .env for native localhost development.
# These values are for local development only. Never commit .env.

POSTGRES_DB=smartpick
POSTGRES_USER=smartpick
POSTGRES_PASSWORD=change-this-local-password

API_PORT=3000
ENGINE_PORT=8000
WEB_PORT=5173

# Used by the API when the route engine runs natively on this computer.
ENGINE_URL=http://127.0.0.1:8000

# Reserved for Prisma and the API as soon as issue #6 is implemented.
DATABASE_URL=postgresql://smartpick:change-this-local-password@127.0.0.1:5432/smartpick?schema=public

# Used by the browser during native development.
VITE_API_BASE_URL=http://127.0.0.1:3000/api/v1
