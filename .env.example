# Copy this file to .env before starting the stack.
# These values are for local development only. Never commit .env.

POSTGRES_DB=smartpick
POSTGRES_USER=smartpick
POSTGRES_PASSWORD=change-this-local-password

API_PORT=3000
WEB_PORT=5173

# Used by the API container. Keep the hostname as "engine" when using Compose.
ENGINE_URL=http://engine:8000

# Used by the browser. Leave this as localhost when running the web container.
VITE_API_BASE_URL=http://localhost:3000/api/v1
