# Copy this file to .env for native localhost development.
# These values are for local development only. Never commit .env.

POSTGRES_DB=smartpick
POSTGRES_USER=smartpick
POSTGRES_PASSWORD=senhasegura

API_PORT=3000
ENGINE_PORT=8000
WEB_PORT=5173

# Used by the API when the route engine runs natively on this computer.
ENGINE_URL=http://127.0.0.1:8000

DATABASE_URL=postgresql://smartpick:senhasegura@127.0.0.1:5432/smartpick?schema=public

# Vite forwards same-origin /api requests to the Node API.
API_PROXY_TARGET=http://127.0.0.1:3000
ENGINE_TIMEOUT_MS=5000
